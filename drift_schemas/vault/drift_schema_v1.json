    {
      "name": "pending_mutations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_mutations\" (\"operation_id\" TEXT NOT NULL, \"family_id\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL, \"entity_type\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"mutation_kind\" TEXT NOT NULL, \"base_revision\" INTEGER NOT NULL, \"payload_json\" TEXT NOT NULL, \"payload_digest\" TEXT NOT NULL, \"protocol_version\" INTEGER NOT NULL, \"state\" TEXT NOT NULL DEFAULT 'pending', \"attempts\" INTEGER NOT NULL DEFAULT 0, \"created_at_us\" INTEGER NOT NULL, \"next_attempt_at_us\" INTEGER NULL, \"lease_expires_at_us\" INTEGER NULL, \"accepted_revision\" INTEGER NULL, PRIMARY KEY (\"operation_id\"), CHECK (mutation_kind IN ('upsert', 'delete')), CHECK (base_revision >= 0), CHECK (json_valid(payload_json)), CHECK (length(payload_digest) = 64), CHECK (protocol_version > 0), CHECK (state IN ('pending', 'in_flight', 'conflicted', 'rejected', 'acknowledged')), CHECK (attempts >= 0), CHECK (accepted_revision IS NULL OR accepted_revision > 0), CHECK (state <> 'acknowledged' OR accepted_revision IS NOT NULL));"
        }
      ]
    },
    {
      "name": "sync_checkpoints",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_checkpoints\" (\"family_id\" TEXT NOT NULL, \"last_sequence\" INTEGER NOT NULL DEFAULT 0, \"authorization_epoch\" INTEGER NOT NULL DEFAULT 0, \"updated_at_us\" INTEGER NOT NULL, PRIMARY KEY (\"family_id\"), CHECK (last_sequence >= 0), CHECK (authorization_epoch >= 0));"
        }
      ]
    },
    {
      "name": "sync_conflicts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_conflicts\" (\"id\" TEXT NOT NULL, \"operation_id\" TEXT NOT NULL UNIQUE REFERENCES pending_mutations (operation_id), \"server_revision\" INTEGER NOT NULL, \"server_snapshot_json\" TEXT NOT NULL, \"detected_at_us\" INTEGER NOT NULL, \"resolved_at_us\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (server_revision > 0), CHECK (json_valid(server_snapshot_json)));"
        }
      ]
    },
    {
