#!/usr/bin/env bash
set -euo pipefail
if [[ "${2:-}" != 'git@github.com:kaif5haikh/FamilyVault.git' ]]; then
  printf '%s\n' 'Push stopped: destination must be the designated FamilyVault SSH repository.' >&2
  exit 1
fi
gh repo view kaif5haikh/FamilyVault --json nameWithOwner,isPrivate |
  python3 -c 'import json,sys; r=json.load(sys.stdin); sys.exit(0 if r["nameWithOwner"] == "kaif5haikh/FamilyVault" and r["isPrivate"] else "Push stopped: repository identity/privacy check failed")'
